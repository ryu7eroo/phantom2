FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash ca-certificates curl wget git \
       python3 python3-pip python3-venv \
       build-essential clang make cmake \
       file binutils gdb \
       jq unzip zip xz-utils bzip2 \
       netcat-openbsd dnsutils iproute2 \
    && rm -rf /var/lib/apt/lists/*

CMD ["sleep", "infinity"]
